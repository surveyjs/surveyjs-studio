# Local-only values for prod-like mode (docker/compose.prod-like.yaml): the production image in the
# mode 1 configuration on the offline replica, signing in through the mock OIDC server.
# The storage key is Microsoft's published, public Azurite development key. The SA password is
# local to the container (docker/azurite.env sets it). Never put a real connection string or
# secret in this file.
# The image sets NODE_ENV=production, HOST=0.0.0.0, PORT=3000 and WEB_ROOT=/app/web.

# --- Mode 1 (hosted, surveyjs.io users) -------------------------------------------------------
APP_EDITION=hosted
ACCOUNT_NOTICES=surveyjs-licenses
# The browser origin: port 3000 of the app, published as 8080.
PUBLIC_BASE_URL=http://localhost:8080
# A local placeholder; production requires its own secret of at least 32 characters.
SESSION_SECRET=prod-like-local-only-session-secret-not-a-real-value

# --- Storage: the replica -----------------------------------------------------------------------
# Azurite shares the app's network namespace (127.0.0.1); SQL Server is the service legacy-sql.
STORAGE_PROVIDER=azure-legacy
LEGACY_SQL_CONNECTION_STRING="Server=legacy-sql,1433;Database=surveyjs_legacy;User Id=sa;Password=Local-Replica-Pwd-1;Encrypt=true;TrustServerCertificate=true"
LEGACY_SURVEYS_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;"
LEGACY_RESULTS_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;"

# --- Sign-in: the mock OIDC server ----------------------------------------------------------------
# It shares the app's network namespace, so the app and the browser both use this issuer. It
# accepts any client id, secret and redirect URI: these values are local placeholders.
IDENTITY_PROVIDER=surveyjs-oidc
OIDC_ISSUER_URL=http://127.0.0.1:18080/surveyjs
OIDC_CLIENT_ID=my-surveys-local
OIDC_CLIENT_SECRET=mock-oidc-local-secret
# The mock refuses an authorization request without the openid scope (see docker/azurite.env).
OIDC_SCOPES="openid profile email"
