# Local-only values for the new hosted server's profile (docker/compose.prod-like.sql.yaml): the
# production image on PostgreSQL with files in S3, signing in through the mock OIDC server.
# Never put a real connection string or secret in this file. The same file feeds Compose's own
# interpolation (the passwords and keys below) and the app container (env_file).
# The image sets NODE_ENV=production, HOST=0.0.0.0, PORT=3000 and WEB_ROOT=/app/web.

APP_EDITION=hosted
# The browser origin: port 3000 of the app, published as 8081.
PUBLIC_BASE_URL=http://localhost:8081
# A local placeholder; production requires its own secret of at least 32 characters.
SESSION_SECRET=prod-like-sql-local-only-session-secret-not-a-real-value
TRUST_PROXY=172.30.0.0/24
READ_ONLY=false

# --- Storage: PostgreSQL and S3 -------------------------------------------------------------------
# The app reaches both by their Compose service names.
STORAGE_PROVIDER=postgres
POSTGRES_PASSWORD="Local-Postgres-Pwd-1"
DATABASE_URL="postgres://surveyjs:Local-Postgres-Pwd-1@postgres:5432/surveyjs_studio"
FILE_STORE=s3
S3_ENDPOINT=http://s3:9000
# The endpoint is plain http to another container: the server allows that only explicitly.
S3_ALLOW_HTTP=true
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=surveyjs-studio-files
S3_ACCESS_KEY_ID=local-s3-access
S3_SECRET_ACCESS_KEY=Local-S3-Secret-Key-1
HISTORY_MAX_ENTRIES=20

# --- Users and sign-in ----------------------------------------------------------------------------
USER_DIRECTORY=local
AUTH_METHODS=surveyjs
# Anyone who signs in with a surveyjs.io account gets a Studio account.
OPEN_SIGN_UP=on
ADMIN_EMAIL=owner@example.com
ACCOUNT_NOTICES=sign-in-licence
# The local demo webhook secret (base64 of "my-surveys-local-demo-webhook-key"), not a real secret.
ACCOUNT_WEBHOOK_SECRET=whsec_bXktc3VydmV5cy1sb2NhbC1kZW1vLXdlYmhvb2sta2V5

# --- The mock OIDC server (docker/compose.prod-like.sql.yaml, service mock-oidc, published on port 18081) ------------------------
# The app shares the mock's network namespace and the mock listens on the published port, so the
# app (its discovery and token requests) and the browser use the same issuer address. A real
# deployment sets OIDC_ISSUER_URL to the identity server's public address.
OIDC_ISSUER_URL=http://127.0.0.1:18081/surveyjs
OIDC_CLIENT_ID=my-surveys-local
OIDC_CLIENT_SECRET=mock-oidc-local-secret
# The mock refuses an authorization request without the openid scope (see docker/azurite.env).
OIDC_SCOPES="openid profile email"
