# Local-only values for the local S3-compatible server (docker/compose.s3.yaml, RustFS) and the
# s3 development mode. The keys are local to the container. Never put real credentials here.
# Explicit environment variables win over this file.
FILE_STORE=s3
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET=surveyjs-studio-files
S3_ACCESS_KEY_ID=local-s3-access
S3_SECRET_ACCESS_KEY=Local-S3-Secret-Key-1
