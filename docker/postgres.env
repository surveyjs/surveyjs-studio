# Local-only values for the postgres development mode (docker/compose.postgres.yaml). The password
# is local to the container. Never put a real connection string in this file.
# Explicit environment variables win over this file.
STORAGE_PROVIDER=postgres
POSTGRES_PASSWORD="Local-Postgres-Pwd-1"
DATABASE_URL="postgres://surveyjs:Local-Postgres-Pwd-1@127.0.0.1:15432/surveyjs_studio"
