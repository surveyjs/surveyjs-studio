# Read by `pnpm test:conformance:azurite` (after docker/azurite.env): run the reference server on
# the azure-legacy provider against the local replica. See README.md.
CONFORMANCE_PROVIDER=azure-legacy
# Placeholders until the mock OIDC server arrives: discovery is lazy, so they are never contacted.
OIDC_ISSUER_URL=http://127.0.0.1:9/placeholder
OIDC_CLIENT_ID=placeholder
OIDC_CLIENT_SECRET=placeholder
