# Read by `pnpm test:conformance:postgres:hosted` (after docker/postgres.env, which has DATABASE_URL, and
# docker/azurite.env, of which the run takes only the mock OIDC settings): run the reference server as the
# hosted edition on the postgres provider, with the local user directory and surveyjs.io sign-in through
# the mock OIDC server, on a new database for the run. See README.md.
CONFORMANCE_PROVIDER=postgres
CONFORMANCE_EDITION=hosted
