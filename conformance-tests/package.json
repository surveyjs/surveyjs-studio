{
  "name": "@surveyjs-studio/conformance-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:azurite": "node --env-file=../docker/azurite.env --env-file=azure-legacy.env node_modules/vitest/vitest.mjs run",
    "test:sqlite": "node --env-file=sqlite.env node_modules/vitest/vitest.mjs run",
    "test:postgres": "node --env-file=../docker/postgres.env --env-file=postgres.env node_modules/vitest/vitest.mjs run",
    "test:s3": "node --env-file=../docker/s3.env --env-file=sqlite.env --env-file=s3.env node_modules/vitest/vitest.mjs run",
    "test:password": "node --env-file=password.env node_modules/vitest/vitest.mjs run",
    "test:oauth": "node --env-file=oauth.env node_modules/vitest/vitest.mjs run src/oauth.test.ts",
    "test:user-api": "node --env-file=user-api.env node_modules/vitest/vitest.mjs run",
    "test:read-only": "node --env-file=read-only.env node_modules/vitest/vitest.mjs run src/read-only.test.ts",
    "test:sandbox": "node --env-file=sandbox.env node_modules/vitest/vitest.mjs run src/surveys.test.ts src/survey-actions.test.ts src/content.test.ts src/files.test.ts src/public.test.ts src/public-files.test.ts src/results.test.ts src/results-details.test.ts src/public-results.test.ts src/views.test.ts src/projects.test.ts src/project-writes.test.ts src/members.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sandbox.json --noEmit"
  },
  "dependencies": {
    "@surveyjs-studio/contract": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "msw": "2.15.0",
    "pg": "8.23.1",
    "vitest": "5.0.2"
  }
}
