{
  "name": "@surveyjs-studio/server",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "fixtures",
    "sql"
  ],
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "dev:demo": "node --env-file=demo.env --watch --import tsx src/main.ts",
    "dev:demo:azurite": "node --env-file=../docker/azurite.env --env-file=demo-azurite.env --watch --import tsx src/main.ts",
    "dev:prod-data": "node --env-file=.env --watch-path=src --import tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/storage-blob": "12.34.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.6",
    "@surveyjs-studio/contract": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "kysely": "0.29.6",
    "mssql": "12.7.2",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1"
  }
}
