# Template for a local run against the real surveyjs.io stores (mode 1.1 data) with sign-in through a
# locally running the site's sign-in service. Copy it to server/.env (gitignored) and fill in the values there.
# Never put a real connection string or secret in this file: it is committed.
# Variables already set in the shell win over the file.

# --- The browser origin -----------------------------------------------------------------------
# The Vite dev server; it proxies /api to the server on 127.0.0.1:3000. Register these in the
# the site's sign-in service client:
#   redirect URI:              http://localhost:5173/api/v1/auth/callback
#   post-logout redirect URI:  http://localhost:5173/
PUBLIC_BASE_URL=http://localhost:5173

# --- Mode 1 (hosted, surveyjs.io users) -------------------------------------------------------
APP_EDITION=hosted
ACCOUNT_NOTICES=surveyjs-licenses
# USER_DIRECTORY defaults to surveyjs-sql with azure-legacy: users are read from the site SQL database.

# --- Storage: the legacy surveyjs.io stores ---------------------------------------------------
STORAGE_PROVIDER=azure-legacy
# The surveyjs.io site SQL database (Surveys, Users, Organizations, licences), mssql format:
# Server=tcp:<server>.database.windows.net,1433;Database=<db>;User Id=<user>;Password=<password>;Encrypt=true
LEGACY_SQL_CONNECTION_STRING=
# The surveys storage account (survey tables and the editor files container), Azure format:
# DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
LEGACY_SURVEYS_STORAGE_CONNECTION_STRING=
# The results storage account, same format.
LEGACY_RESULTS_STORAGE_CONNECTION_STRING=

# --- Sign-in: the local the site's sign-in service ---------------------------------------------------------
IDENTITY_PROVIDER=surveyjs-oidc
# The issuer named by its metadata (http://localhost:5100 redirects here). Node must trust its
# development certificate: see the run script.
OIDC_ISSUER_URL=https://localhost:7100
OIDC_CLIENT_ID=my-surveys
OIDC_CLIENT_SECRET=
# the site's sign-in service publishes RFC 8414 oauth-authorization-server metadata (the default) with the
# scopes profile and email and no ID token (ADR 0008), so both keep their defaults.
# OIDC_DISCOVERY=
# OIDC_SCOPES=

# --- Session ----------------------------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
