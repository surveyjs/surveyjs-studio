# Settings for `pnpm dev:bridge`: the bridge in front of `pnpm demo`'s server (port 3000).
# Nothing listens on the old-service URL, so forwarded paths answer an empty 500; point
# BRIDGE_LEGACY_URL at a stub to try them. Variables already set in the shell win over this file.
BRIDGE_STUDIO_URL=http://127.0.0.1:3000/api/v1
BRIDGE_LEGACY_URL=http://127.0.0.1:3009
