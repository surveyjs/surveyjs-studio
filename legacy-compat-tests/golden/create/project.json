{
  "source": "derived",
  "description": "ownerId naming a project the caller is in: made in the project",
  "difference": "The old API's create left CreatorId all zeros and IsPublished null until the survey was published or unpublished; the bridge answers the real creator and Studio's published flag (never null), as docs/api/legacy-compat.md lists. The old CreatedAt was the server's local time; the bridge's is UTC.",
  "creates": true,
  "request": {
    "method": "POST",
    "path": "/private/v1/Surveys/create",
    "query": {
      "accessKey": "{{accessKey}}",
      "name": "Legacy compat created",
      "ownerId": "55555555-0000-4000-8000-a00000000001"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "json": {
        "Name": "Legacy compat created",
        "IsArchived": false,
        "UserId": "55555555-0000-4000-8000-a00000000001",
        "CreatorId": "{{owner.userId}}",
        "PostId": "<guid>",
        "ResultId": "<guid>",
        "PublishId": null,
        "IsPublished": true,
        "UseCookies": false,
        "UpdatedOn": "<iso>",
        "CreatedAt": "<iso>",
        "AllowAccessResult": false,
        "StoreIPAddress": false,
        "Theme": null,
        "Json": null,
        "Id": "<guid>"
      }
    }
  }
}
