{
  "source": "derived",
  "description": "a survey with a theme: Theme is the theme as JSON text",
  "difference": "The old API's create left CreatorId all zeros and IsPublished null until the survey was published or unpublished; the bridge answers the real creator and Studio's published flag (never null), as docs/api/legacy-compat.md lists.",
  "setup": {
    "survey": {
      "theme": {
        "themeName": "flat",
        "colorPalette": "dark"
      }
    }
  },
  "request": {
    "method": "GET",
    "path": "/private/v1/Surveys/getSurveyInfo",
    "query": {
      "accessKey": "{{accessKey}}",
      "surveyId": "{{survey.surveyId}}"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "json": {
        "Info": {
          "Name": "Legacy compat",
          "IsArchived": false,
          "UserId": "{{owner.userId}}",
          "CreatorId": "{{owner.userId}}",
          "PostId": "{{survey.postId}}",
          "ResultId": "{{survey.resultId}}",
          "PublishId": null,
          "IsPublished": true,
          "UseCookies": false,
          "UpdatedOn": "<iso>",
          "CreatedAt": "<iso>",
          "AllowAccessResult": false,
          "StoreIPAddress": false,
          "Theme": "{\"themeName\":\"flat\",\"colorPalette\":\"dark\"}",
          "Json": null,
          "Id": "{{survey.surveyId}}"
        },
        "Json": "{&quot;title&quot;:&quot;Customer feedback&quot;,&quot;pages&quot;:[{&quot;name&quot;:&quot;page1&quot;,&quot;elements&quot;:[{&quot;type&quot;:&quot;rating&quot;,&quot;name&quot;:&quot;satisfaction&quot;,&quot;title&quot;:&quot;How satisfied are you?&quot;},{&quot;type&quot;:&quot;file&quot;,&quot;name&quot;:&quot;receipt&quot;,&quot;title&quot;:&quot;Upload your receipt&quot;}]}]}"
      }
    }
  }
}
