{
  "source": "derived",
  "description": "a project member who is not an admin: the modify refusal",
  "setup": {
    "survey": {
      "archived": true,
      "projectId": "55555555-0000-4000-8000-a00000000001"
    }
  },
  "request": {
    "method": "PUT",
    "path": "/private/v1/Surveys/restore",
    "query": {
      "accessKey": "{{memberKey}}",
      "id": "{{survey.surveyId}}"
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "json": "You are not authorized to modify the survey {{survey.surveyId}}"
    }
  }
}
