{
  "source": "derived",
  "description": "/public/Survey/upload; the first file part of any field name, postId in any case",
  "difference": "The old API named the stored file with a new GUID (dxsimage:{guid}.png); the bridge answers Studio's file ID, 64 hex digits. Callers keep the name as an opaque answer value.",
  "setup": {
    "survey": {}
  },
  "request": {
    "method": "POST",
    "path": "/public/Survey/upload",
    "body": {
      "multipart": [
        {
          "name": "attachment",
          "filename": "photo.png",
          "contentType": "image/png",
          "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
        },
        {
          "name": "POSTID",
          "value": "{{survey.postId}}"
        }
      ]
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "json": "dxsimage:<hex64>.png"
    }
  }
}
