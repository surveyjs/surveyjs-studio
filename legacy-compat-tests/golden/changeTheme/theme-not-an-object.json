{
  "source": "derived",
  "description": "a ThemeJson that is no JSON object: an empty 400",
  "difference": "The old API stored any text as the theme and answered an empty 200; the bridge refuses a theme that is not a JSON object (docs/api/legacy-compat.md).",
  "setup": {
    "survey": {}
  },
  "request": {
    "method": "PUT",
    "path": "/private/v1/Surveys/changeTheme",
    "query": {
      "accessKey": "{{accessKey}}"
    },
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "json": {
        "Id": "{{survey.surveyId}}",
        "ThemeJson": "dark"
      }
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": null,
      "content-length": "0"
    },
    "body": null
  }
}
