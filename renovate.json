{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "SurveyJS packages always move together, as soon as they are released (no minimum release age: the app follows SurveyJS's own releases)",
      "groupName": "SurveyJS",
      "matchPackageNames": ["survey-*"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": null
    },
    {
      "description": "legacy-compat-tests pins the Form Library v1 (survey-core 1.x), as pages built for the old service use it: it stays on 1.x, outside the SurveyJS group, after the usual release age",
      "matchFileNames": ["legacy-compat-tests/package.json"],
      "matchPackageNames": ["survey-core"],
      "groupName": "Form Library v1 (legacy-compat-tests)",
      "allowedVersions": "<2",
      "minimumReleaseAge": "14 days"
    },
    {
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["*", "!survey-*"]
    },
    {
      "description": "Node.js stays on the pinned LTS major (.nvmrc and engines.node)",
      "matchDatasources": ["node-version"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    }
  ]
}
