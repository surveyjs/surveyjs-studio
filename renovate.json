{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "SurveyJS packages always move together, as soon as they are released (no minimum release age: the app follows SurveyJS's own releases)",
      "groupName": "SurveyJS",
      "matchPackageNames": ["survey-*"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["*", "!survey-*"]
    },
    {
      "description": "Node.js stays on the pinned LTS major (.nvmrc and engines.node)",
      "matchDatasources": ["node-version"],
      "matchDepNames": ["node"],
      "allowedVersions": "<25"
    }
  ]
}
