{
  "name": "surveyjs-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "node -e \"const f='./scripts/git-hooks/install.mjs';if(require('fs').existsSync(f))import(f).then((m)=>m.installHooks())\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tsconfig.json --noEmit",
    "check:deps": "tsx scripts/check-deps/cli.ts",
    "check:docs-links": "node --import tsx scripts/docs-links/cli.ts",
    "check:example-shell": "node --import tsx scripts/example-shell/cli.ts",
    "test:unit": "vitest run --project=!providers-azurite --project=!providers-postgres --project=!providers-s3",
    "test:providers:azurite": "node --env-file=docker/azurite.env node_modules/vitest/vitest.mjs run --project=providers-azurite",
    "test:providers:postgres": "node --env-file=docker/postgres.env node_modules/vitest/vitest.mjs run --project=providers-postgres",
    "test:providers:s3": "node --env-file=docker/s3.env node_modules/vitest/vitest.mjs run --project=providers-s3",
    "test:conformance": "node --import tsx scripts/conformance/cli.ts --",
    "test:conformance:azurite": "pnpm --filter @surveyjs-studio/conformance-tests test:azurite",
    "test:conformance:sqlite": "pnpm --filter @surveyjs-studio/conformance-tests test:sqlite",
    "test:conformance:postgres": "pnpm --filter @surveyjs-studio/conformance-tests test:postgres",
    "test:conformance:s3": "pnpm --filter @surveyjs-studio/conformance-tests test:s3",
    "test:conformance:password": "pnpm --filter @surveyjs-studio/conformance-tests test:password",
    "test:conformance:oauth": "pnpm --filter @surveyjs-studio/conformance-tests test:oauth",
    "test:conformance:user-api": "pnpm --filter @surveyjs-studio/conformance-tests test:user-api",
    "test:conformance:read-only": "pnpm --filter @surveyjs-studio/conformance-tests test:read-only",
    "test:conformance:sandbox": "pnpm --filter @surveyjs-studio/conformance-tests test:sandbox",
    "test": "pnpm test:unit && pnpm test:conformance",
    "e2e": "pnpm --filter @surveyjs-studio/e2e test",
    "e2e:azurite": "pnpm --filter @surveyjs-studio/e2e test:azurite",
    "e2e:sqlite": "pnpm --filter @surveyjs-studio/e2e test:sqlite",
    "e2e:postgres": "pnpm --filter @surveyjs-studio/e2e test:postgres",
    "e2e:password": "pnpm --filter @surveyjs-studio/e2e test:password",
    "e2e:oauth": "pnpm --filter @surveyjs-studio/e2e test:oauth",
    "e2e:self-hosted": "pnpm --filter @surveyjs-studio/e2e test:self-hosted",
    "e2e:sandbox": "pnpm --filter @surveyjs-studio/e2e test:sandbox",
    "e2e:sandbox:url": "pnpm --filter @surveyjs-studio/e2e test:sandbox:url",
    "e2e:sandbox:subpath": "pnpm --filter @surveyjs-studio/e2e test:sandbox:subpath",
    "e2e:prod-like": "pnpm --filter @surveyjs-studio/e2e test:prod-like",
    "e2e:visual": "pnpm --filter @surveyjs-studio/e2e test:visual",
    "e2e:visual:self-hosted": "pnpm --filter @surveyjs-studio/e2e test:visual:self-hosted",
    "e2e:visual:report": "pnpm --filter @surveyjs-studio/e2e exec playwright show-report visual-report",
    "visual:capture": "pnpm --filter @surveyjs-studio/e2e capture",
    "lint:contract": "pnpm --filter @surveyjs-studio/contract lint && pnpm --filter @surveyjs-studio/contract check:generated",
    "build": "pnpm --filter @surveyjs-studio/contract build:docs && pnpm --filter @surveyjs-studio/web build",
    "demo:azurite:up": "docker compose --env-file docker/azurite.env -f docker/compose.azurite.yaml up -d --wait && pnpm legacy:load",
    "demo:azurite:down": "docker compose --env-file docker/azurite.env -f docker/compose.azurite.yaml down -v",
    "postgres:up": "docker compose --env-file docker/postgres.env -f docker/compose.postgres.yaml up -d --wait",
    "postgres:down": "docker compose --env-file docker/postgres.env -f docker/compose.postgres.yaml down -v",
    "s3:up": "docker compose --env-file docker/s3.env -f docker/compose.s3.yaml up -d --wait && pnpm s3:bucket create surveyjs-studio-files",
    "s3:bucket": "node --env-file=docker/s3.env --import tsx server/src/cli/s3-bucket.ts --",
    "s3:down": "docker compose --env-file docker/s3.env -f docker/compose.s3.yaml down -v",
    "oauth-stub": "node --import tsx server/src/cli/oauth-stub.ts --",
    "user-api:stub": "node --import tsx server/src/users/surveyjs-api/stub-cli.ts --",
    "inspect:legacy": "node --import tsx server/src/cli/inspect-legacy.ts --",
    "inspect:legacy-schema": "node --import tsx server/src/cli/inspect-legacy-schema.ts --",
    "account:erase": "node --import tsx server/src/cli/account-erase.ts --",
    "smoke:legacy": "node --import tsx server/src/cli/smoke-legacy.ts --",
    "account:reconcile": "node --import tsx server/src/cli/account-reconcile.ts --",
    "db:migrate": "node --import tsx server/src/cli/db.ts migrate --",
    "db:status": "node --import tsx server/src/cli/db.ts status --",
    "seed": "node --import tsx server/src/cli/db.ts seed --",
    "backup": "node --import tsx server/src/cli/surveyjs-studio.ts backup --",
    "restore": "node --import tsx server/src/cli/surveyjs-studio.ts restore --",
    "seed:sqlite": "pnpm --filter @surveyjs-studio/server seed:sqlite",
    "seed:postgres": "pnpm postgres:up && pnpm --filter @surveyjs-studio/server seed:postgres",
    "webhook:account-deleted": "node --import tsx server/src/cli/send-account-deleted.ts --",
    "legacy:load": "node --env-file=docker/azurite.env --import tsx server/src/legacy/load-fixtures.ts",
    "dev:sandbox": "pnpm --filter @surveyjs-studio/web dev:sandbox",
    "build:sandbox": "pnpm --filter @surveyjs-studio/web build:sandbox",
    "demo": "pnpm --filter @surveyjs-studio/contract build:docs && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo\" \"pnpm --filter @surveyjs-studio/web dev\"",
    "demo:preview": "pnpm build && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo\" \"pnpm --filter @surveyjs-studio/web preview\"",
    "demo:azurite": "pnpm --filter @surveyjs-studio/contract build:docs && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo:azurite\" \"pnpm --filter @surveyjs-studio/web dev\"",
    "dev:sqlite": "pnpm --filter @surveyjs-studio/contract build:docs && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo:sqlite\" \"pnpm --filter @surveyjs-studio/web dev\"",
    "dev:postgres": "pnpm postgres:up && pnpm --filter @surveyjs-studio/contract build:docs && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo:postgres\" \"pnpm --filter @surveyjs-studio/web dev\"",
    "dev:s3": "pnpm s3:up && pnpm --filter @surveyjs-studio/contract build:docs && concurrently -n server,web -c blue,green \"pnpm --filter @surveyjs-studio/server dev:demo:s3\" \"pnpm --filter @surveyjs-studio/web dev\"",
    "dev:prod-data": "tsx scripts/dev-prod-data/cli.ts",
    "image:build": "docker build -t surveyjs-studio:local .",
    "image:build:self-hosted": "docker build --target self-hosted -t surveyjs-studio:self-hosted .",
    "image:prod-data": "node --import tsx scripts/image-prod-data/cli.ts --",
    "scan:secrets": "node --import tsx scripts/secrets-scan/cli.ts --",
    "image:checks": "node --import tsx scripts/image-checks/cli.ts --",
    "release:tags": "node --import tsx scripts/release-tags/cli.ts --",
    "sandbox:serve": "node scripts/sandbox-host/serve.mjs",
    "sandbox:wait": "node scripts/sandbox-host/wait-for-version.mjs",
    "sandbox:seed": "node --import tsx scripts/sandbox-seed/cli.ts",
    "prod-like:up": "docker compose --env-file docker/azurite.env -f docker/compose.prod-like.yaml up -d --build --wait && pnpm legacy:load",
    "prod-like:up:e2e": "docker compose --env-file docker/azurite.env -f docker/compose.prod-like.yaml -f docker/compose.prod-like.e2e.yaml up -d --build --wait && pnpm legacy:load",
    "prod-like:down": "docker compose --env-file docker/azurite.env -f docker/compose.prod-like.yaml down -v"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
