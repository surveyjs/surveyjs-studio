{
  "name": "@my-surveys/contract",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o generated/openapi.d.ts",
    "lint": "redocly lint openapi.yaml",
    "check:generated": "tsx scripts/check-generated.ts",
    "build:docs": "redocly build-docs openapi.yaml --disableGoogleFont -o dist/reference.html",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@redocly/cli": "2.56.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
