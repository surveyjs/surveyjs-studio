# Copy this file to .env next to the compose file and replace every placeholder.
# Keep .env private: it holds passwords. Never commit it.

# The address people open in a browser (no trailing slash). Links in e-mails and the setup page use it.
PUBLIC_BASE_URL=https://surveys.example.com

# The first administrator. The password is one-time: you must change it at first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-first-password

# Optional: the image (default: the published one) and the host port (default: 8080).
# SURVEYJS_STUDIO_IMAGE=
# SURVEYJS_STUDIO_PORT=8080

# Only for compose.postgres.yml. Use letters and digits in POSTGRES_PASSWORD (it goes into a URL).
POSTGRES_PASSWORD=change-me-postgres
S3_ACCESS_KEY_ID=change-me-access-key
S3_SECRET_ACCESS_KEY=change-me-secret-key
