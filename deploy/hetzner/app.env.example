# The app's settings for mode 1.1 (docs/operations.md › Configuration by deployment mode).
# Copy it, fill every <placeholder>, pass the copy to setup.sh --env-file, then delete the copy.
# Never commit a filled copy. A value that holds $ goes in single quotes: KEY='a$b'.
PUBLIC_BASE_URL=https://studio.surveyjs.io
SESSION_SECRET=<at least 32 random characters>
APP_EDITION=hosted
STORAGE_PROVIDER=azure-legacy
LEGACY_SQL_CONNECTION_STRING=<the site database>
LEGACY_SURVEYS_STORAGE_CONNECTION_STRING=<the surveys storage account>
LEGACY_RESULTS_STORAGE_CONNECTION_STRING=<the results storage account>
OIDC_ISSUER_URL=https://auth.surveyjs.io
OIDC_CLIENT_ID=<the client id>
OIDC_CLIENT_SECRET=<the client secret>
ACCOUNT_NOTICES=surveyjs-licenses
SURVEYJS_LICENSE_KEY=<the SurveyJS licence key>
TRUST_PROXY=172.30.0.0/24
# Serves /metrics on a separate port that Compose never publishes (reach it from the Compose network only).
# METRICS_PORT=9464
READ_ONLY=true
# Users cannot revoke their legacy access key until the old API checks keys through Studio (ADR 0037).
LEGACY_KEY_REVOKE=false

# --- The new server (a second profile; not for today's server) ----------------------------------
# Studio on PostgreSQL with files in S3, signing in with surveyjs.io accounts. Fill the
# placeholders and keep the lines you need in place of the mode 1.1 storage settings above
# (STORAGE_PROVIDER, LEGACY_*, ACCOUNT_NOTICES, READ_ONLY, LEGACY_KEY_REVOKE). docker/prod-like.sql.env
# is this profile with local values.
# APP_EDITION=hosted
# STORAGE_PROVIDER=postgres
# DATABASE_URL=<the PostgreSQL connection string>
# FILE_STORE=s3
# S3_BUCKET=<the bucket>
# S3_REGION=<the bucket's region>
# S3_ENDPOINT=<the S3 endpoint, only for a provider other than AWS>
# S3_FORCE_PATH_STYLE=<true when the provider needs path-style addresses>
# S3_ACCESS_KEY_ID=<the access key id>
# S3_SECRET_ACCESS_KEY=<the secret access key>
# HISTORY_MAX_ENTRIES=20
# USER_DIRECTORY=local
# AUTH_METHODS=surveyjs
# OPEN_SIGN_UP=on
# ADMIN_EMAIL=<the first admin's email>
# ACCOUNT_NOTICES=sign-in-licence
# ACCOUNT_WEBHOOK_SECRET=<whsec_... from the site>
# OIDC_ISSUER_URL, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET as above.
